{
	"name": "@superset/office-harness",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Seats for Claude Code, Codex and agy in a shared office: inbox, office tools, presence, hand-off guards.",
	"exports": {
		".": "./src/lib.ts",
		"./types": "./src/office/types.ts"
	},
	"scripts": {
		"office": "bun run src/index.ts",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false",
		"test": "bun test --pass-with-no-tests"
	},
	"dependencies": {
		"@agentclientprotocol/claude-agent-acp": "0.85.0",
		"@agentclientprotocol/codex-acp": "2.1.0",
		"@modelcontextprotocol/sdk": "1.31.0",
		"@superset/chat-runtime": "workspace:*",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@superset/typescript": "workspace:*",
		"@types/node": "24.12.0",
		"bun-types": "1.4.3",
		"typescript": "7.0.2"
	}
}
